# Copy this file to .env and fill in your values.
# .env is loaded automatically by bot.py at startup.
# Actual environment variables always take precedence over values here.

DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-guild-id-here
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_SHEET_KEY=google-sheet-key-here

LOG_LEVEL=DEBUG

# Optional — defaults to 8080
DM_PANEL_PORT=8080

# DM panel authentication (defense-in-depth; the panel should also sit behind a
# private network such as Tailscale). Generate the password hash with:
#   python -m webui.auth
# and paste the printed DM_PANEL_PASSWORD_HASH line below.
DM_PANEL_PASSWORD_HASH=
# Stable HMAC key for signing session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, an ephemeral key is generated at startup and logins drop on restart.
DM_PANEL_SECRET_KEY=
# Optional — session cookie lifetime in days (default 30).
DM_PANEL_SESSION_DAYS=30
# Optional — set to "false" only for plain-http local testing (default: Secure on,
# which requires HTTPS, e.g. via Tailscale Serve).
DM_PANEL_COOKIE_SECURE=true

# Optional passwordless login via the /dm_panel slash command: it DMs the owner a
# one-time link that signs them into the panel. Requires both of these.
#   DM_PANEL_OWNER_ID  — your Discord user ID (only this user may run /dm_panel).
#   DM_PANEL_BASE_URL  — public base URL of the panel (no trailing slash),
#                        e.g. the Tailscale Serve address.
DM_PANEL_OWNER_ID=your-discord-user-id-here
DM_PANEL_BASE_URL=https://your-host.your-tailnet.ts.net

# Discord integration tests (tests/discord_integration/)
# Channel must exist in your guild; bot must have Send/Read/Manage Messages there.
# The bot will post and delete messages in this channel during test runs.
DISCORD_TEST_CHANNEL_ID=your-test-channel-id-here
# Your own Discord user ID — used as the DM in test sessions.
DISCORD_TEST_DM_USER_ID=your-user-id-here
